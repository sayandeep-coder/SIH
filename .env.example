# ==========================================
# DATABASE - NEON POSTGRESQL
# ==========================================

DATABASE_URL=postgresql+asyncpg://username:password@host/database?ssl=require


# ==========================================
# APPLICATION
# ==========================================

APP_NAME=Airfare Price Index
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000


# ==========================================
# GOOGLE FLIGHTS
# ==========================================

GOOGLE_FLIGHTS_BASE_URL=https://www.google.com/travel/flights/search

GOOGLE_FLIGHTS_LANGUAGE=en
GOOGLE_FLIGHTS_COUNTRY=IN


# ==========================================
# REDIS / CELERY
# ==========================================
# Many hosted Redis free tiers only expose DB index 0 — use distinct key
# prefixes rather than distinct DB indices if you need to separate broker
# and result-backend traffic.

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# ==========================================
# SCRAPER
# ==========================================

SCRAPER_HEADLESS=false

SCRAPER_TIMEOUT=30000

SCRAPER_MAX_RETRIES=3

SCRAPER_RATE_LIMIT_SECONDS=2


# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO